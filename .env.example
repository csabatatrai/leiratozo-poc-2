# Titkok/eszközbeállítások — sosem YAML-be, mindig env-be. Ld. docs/phase1-terv.md
# 7. és 10. szakasz.

CONFIG_PATH=config/config.example.yaml

API_KEY=change-me
# pyannote/diart gated modelljeihez (HF licenc-elfogadás után) — ld. README.md
HF_TOKEN=
# Kötelező, ha storage.profile_store.backend=encrypted_sqlite (README.md GDPR
# szakasz). Generálás:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_ENCRYPTION_KEY=

# Példa nested env-override (pydantic-settings, env_nested_delimiter="__"):
# MODELS__ASR__ADAPTER=vosk
# DEVICE__DEFAULT=cpu
